spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/poolfolio_db
    username: poolfolio
    password: your_local_password_here
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    open-in-view: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

server:
  port: 8080

app:
  jwt:
    secret: "replace-with-a-long-random-secret-at-least-256-bits"
    expiration-ms: 86400000
